APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://astropollo.tatancloud.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Ruta al JSON de cuenta de servicio de Firebase (FCM HTTP v1)
# FCM_CREDENCIALES=storage/app/firebase/cuenta-servicio.json  (por defecto si se omite)

# OneSignal (notificaciones push). Cada app tiene su App ID y su App API Key:
# Panel OneSignal > (app) > Settings > Keys & IDs
# App Cliente (astroclientecompose / AstroClienteKMP)
ONE_SIGNAL_APP_CLIENTE=
ONE_SIGNAL_KEY_CLIENTE=
# App Restaurante (astrorestaurantecompose)
ONE_SIGNAL_APP_RESTAURANTE=
ONE_SIGNAL_KEY_RESTAURANTE=
# android_channel_id (categorias de notificacion de cada app en OneSignal). Opcionales.
ONE_SIGNAL_GRUPO_PASIVO_CLIENTE=
ONE_SIGNAL_GRUPO_PASIVO_RESTAURANTE=
ONE_SIGNAL_GRUPO_ALARMA_RESTAURANTE=

# WhatsApp Cloud API (Meta): aviso al restaurante cuando entra una orden nueva.
# developers.facebook.com > (app) > WhatsApp > Configuracion de la API
# Usar un token PERMANENTE de usuario del sistema (el temporal vence en 24 h).
# Vacios = no se envia WhatsApp (solo push).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Plantilla aprobada (categoria Utilidad), cuerpo: "Nueva orden #{{1}}, revisar App"
WHATSAPP_PLANTILLA_ORDEN=nueva_orden
WHATSAPP_IDIOMA=es
# se antepone a numeros locales de 8 digitos
WHATSAPP_CODIGO_PAIS=503
